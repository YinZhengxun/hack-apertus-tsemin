# Line endings: LF everywhere (the Docker entry point and the Makefile must not get CRLF on a Windows checkout,
# and the sha256 of the prediction files in the README must match on every platform).
* text=auto eol=lf
*.png binary
*.pdf binary
*.gz binary

# Generated pages (the viewer embeds all predictions as JSON, 8 MB): keep them out of the language statistics
track_2a/demo/viewer.html linguist-generated=true
track_2a/docs/*.html linguist-generated=true
